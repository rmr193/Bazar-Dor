# =============================================================================
# Bazar Dor — environment variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# In Vercel: Project → Settings → Environment Variables
# =============================================================================


# -----------------------------------------------------------------------------
# BetterAuth (REQUIRED in production)
# -----------------------------------------------------------------------------
# Long random string used to sign session cookies.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# The public URL of the app. Must match the deployment host exactly.
# Local dev: http://localhost:3000
# Vercel:    https://bazar-dor-omega-six.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. If unset, falls back to NEXT_PUBLIC_APP_URL.
# BETTER_AUTH_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# Get these from https://console.cloud.google.com/apis/credentials
#   1. Create a project (or use existing)
#   2. Configure the OAuth consent screen (External, add scopes: email, profile)
#   3. Create credentials → OAuth client ID → Application type: Web application
#   4. Add Authorized JavaScript origins:
#        http://localhost:3000
#        https://bazar-dor-omega-six.vercel.app
#   5. Add Authorized redirect URIs:
#        http://localhost:3000/api/auth/callback/google
#        https://bazar-dor-omega-six.vercel.app/api/auth/callback/google
#   6. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# GitHub OAuth
# -----------------------------------------------------------------------------
# Get these from https://github.com/settings/developers → New OAuth App
#   1. Application name:  Bazar Dor (or anything you like)
#   2. Homepage URL:      http://localhost:3000  (or your deployed URL)
#   3. Authorization callback URL:
#        http://localhost:3000/api/auth/callback/github
#   4. (For production, register a second OAuth App pointing to the Vercel URL)
#   5. Generate a client secret, then copy Client ID and Secret below
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Feature flags (optional)
# -----------------------------------------------------------------------------
# If set to "true", enables extra diagnostic logs in the auth flow.
# NEXT_PUBLIC_AUTH_DEBUG=false
